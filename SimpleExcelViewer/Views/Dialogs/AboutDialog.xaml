<UserControl
	x:Class="SimpleExcelViewer.Views.Dialogs.AboutDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:base="RW.Base.WPF"
	xmlns:c="clr-namespace:SimpleExcelViewer.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SimpleExcelViewer.Views.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:root="clr-namespace:SimpleExcelViewer"
	xmlns:wpf="RW.Common.WPF"
	d:Background="White"
	d:DataContext="{d:DesignInstance Type=local:AboutDialogViewModel}"
	Style="{StaticResource DialogStyle}"
	DataContext="{base:DISource Type=local:AboutDialogViewModel}"
	mc:Ignorable="d">

	<StackPanel>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Border>
				<Image
					Height="50"
					Margin="8,0"
					VerticalAlignment="Top"
					Source="/Icon.png"/>
			</Border>

			<Border Grid.Column="1">
				<StackPanel Margin="8,0">
					<TextBlock FontSize="24" Text="{x:Static root:AppConfig.DisplayAppName}"/>
					<TextBlock FontSize="14" Text="{Binding AppManager.AppFullVersion}"/>
				</StackPanel>
			</Border>

		</Grid>

		<Separator Margin="0,8"/>

		<Border Margin="2,0">
			<StackPanel>
				<TextBlock Text="By RainbowWolfer (R.Wolfer)"/>
				<c:HyperLink DisplayText="Github" Link="{x:Static root:AppConfig.GithubURL}"/>
			</StackPanel>
		</Border>

		<Separator Margin="0,6,0,2"/>
		<Grid Margin="4,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="12"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				Margin="0,2"
				Foreground="Gray"
				Text="Administrator:"/>
			<TextBlock
				Grid.Row="0"
				Grid.Column="2"
				Margin="0,2"
				Text="{Binding AdministratorStatus}"/>

			<TextBlock
				Grid.Row="1"
				Grid.Column="0"
				Margin="0,2"
				Foreground="Gray"
				Text="Architecture:"/>
			<TextBlock
				Grid.Row="1"
				Grid.Column="2"
				Margin="0,2"
				Text="{Binding ProcessArchitecture}"/>

			<TextBlock
				Grid.Row="2"
				Grid.Column="0"
				Margin="0,2"
				Foreground="Gray"
				Text="Build Mode:"/>
			<TextBlock
				Grid.Row="2"
				Grid.Column="2"
				Margin="0,2"
				Text="{Binding AppManager.BuildMode}"/>

			<TextBlock
				Grid.Row="3"
				Grid.Column="0"
				Margin="0,2"
				Foreground="Gray"
				Text="Deployment Mode:"/>
			<TextBlock
				Grid.Row="3"
				Grid.Column="2"
				Margin="0,2"
				Text="{Binding DeploymentMode}"/>

			<TextBlock
				Grid.Row="4"
				Grid.Column="0"
				Margin="0,2"
				Foreground="Gray"
				Text="Runtime:"/>
			<TextBlock
				Grid.Row="4"
				Grid.Column="2"
				Margin="0,2"
				Text="{Binding FrameworkVersion}"/>

			<TextBlock
				Grid.Row="5"
				Grid.Column="0"
				Margin="0,2"
				Foreground="Gray"
				Text="OS:"/>
			<TextBlock
				Grid.Row="5"
				Grid.Column="2"
				Margin="0,2"
				Text="{Binding OSDescription}"/>

			<TextBlock
				Grid.Row="6"
				Grid.Column="0"
				Margin="0,2"
				Foreground="Gray"
				Text="Startup Time:"/>
			<TextBlock
				Grid.Row="6"
				Grid.Column="2"
				Margin="0,2"
				Text="{Binding AppManager.AppStartupTimeSpan, StringFormat='mm\\:ss\\:fff'}"/>

			<TextBlock
				Grid.Row="7"
				Grid.Column="0"
				Margin="0,2"
				Foreground="Gray"
				Text="XML Language:"/>
			<TextBlock
				Grid.Row="7"
				Grid.Column="2"
				Margin="0,2"
				Text="{Binding AppManager.Language}"/>

		</Grid>
	</StackPanel>

</UserControl>
